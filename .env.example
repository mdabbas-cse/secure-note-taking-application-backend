# ---------------------------------------------------------------------------
# Local development defaults. Copy to .env (never commit .env files).
# On Vercel, set these in Project Settings -> Environment Variables instead.
# ---------------------------------------------------------------------------

# development | test | production   (Vercel: production)
NODE_ENV=development

# Local server port (ignored on Vercel)
PORT=4000

# Local: docker compose MongoDB. Production: your Atlas SRV string, e.g.
# mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/secure_notes?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/secure_notes

# At least 32 random characters. The placeholder below is rejected at startup.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# Exact frontend origin(s), comma separated. REQUIRED in production, https only,
# no wildcards, no localhost (e.g. https://secure-notes-frontend.vercel.app).
# In development http://localhost:5173 is always allowed.
# FRONTEND_URL=https://secure-notes-frontend.vercel.app

# bcrypt cost factor (10-14 recommended)
BCRYPT_SALT_ROUNDS=12

# Rate limit for /api/auth/login and /api/auth/register (per client IP)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- Optional overrides (defaults are derived from NODE_ENV / Vercel) -------
# COOKIE_SECURE=true          # default: true in production
# COOKIE_SAME_SITE=none       # default: none in production, strict otherwise
# TRUST_PROXY=1               # default: 1 on Vercel, 0 elsewhere
# MONGO_AUTO_INDEX=true       # default: true, except production (use db:indexes)
# MONGO_MAX_POOL_SIZE=10

# --- Only for `npm run db:seed-admin` (creates a NEW admin; never promotes) --
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
